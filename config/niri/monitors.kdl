// Monitor output configuration.
// Run `niri msg outputs` to find your output names and available modes.
// The built-in laptop monitor is usually "eDP-1".
// Find the full list of options on the wiki:
// https://yalter.github.io/niri/Configuration:-Outputs
//
// The eDP-1 block is disabled by default (/-) since output names vary per system.
// Remove the "/- " prefix and update the output name to activate.
// omarchy-niri-monitor-scaling-cycle will activate and edit the scale value here.

/-output "eDP-1" {
    // off

    // Resolution and refresh rate. Omit to auto-select.
    // mode "1920x1080@60.008"

    // Scale factor. Managed by omarchy-niri-monitor-scaling-cycle.
    // scale 1.25

    // Rotation: normal, 90, 180, 270, flipped, flipped-90, flipped-180, flipped-270
    // transform "normal"

    // Position in the global coordinate space.
    // position x=0 y=0
}

// Example: external monitor
/-output "HDMI-A-1" {
    // off
    // mode "2560x1440@143.912"
    // scale 1.0
    // transform "normal"
    // position x=1536 y=0
}
