{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 25,
  "modules-left": [
    "niri/workspaces",
    "wlr/taskbar",
    "niri/window"
  ],
  "modules-center": [
    "cpu",
    "memory",
    "custom/screenrecording-indicator"
  ],
  "modules-right": [
    "bluetooth",
    "network",
    "backlight",
    "pulseaudio",
    "pulseaudio#microphone",
    "battery",
    "clock",
  ],
"niri/workspaces": {
  "format": "{icon} {index}",
  "format-icons": {
    "focused": "󰔰",
    "urgent": "󰀦",
    "default": ""
  }
},
  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": false,
    "active-first":true,
    "icon-size": 17,
    "tooltip": true,
    "tooltip-format": "{title} | {app_id}",
    "on-click": "activate",
    "on-click-middle": "close",

  },
  "niri/window": {
    "format": "{title}",
    "tooltip": false,
    "icon": true,
    "icon-size": 17,
    "interval": 1,
    "separate-outputs": true,

  },
  "cpu": {
    "interval": 2,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "tooltip": false,
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
  },
  "memory": {
    "interval": 30,
    "tooltip": false,
    "format": "  {used:0.1f}G",
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}",
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select",
    "interval": 60,
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "",
        "days": "<span color='#d4be98'>{}</span>",
        "weekdays": "<span color='#a9b665'><b>{}</b></span>",
        "today": "<span color='#e78a4e'><b><u>{}</u></b></span>"
      }
    },
  },
  "backlight": {
    "device": "intel_backlight",
    "tooltip":false,
    "format": " {percent}%",
    "on-scroll-up": "",
    "on-scroll-down": "",
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "on-click": "omarchy-menu power",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": " Muted",
    "on-click": "omarchy-launch-audio",
    "on-scroll-up": "",
    "on-scroll-down": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "default": [
        " "
      ],
    },
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "",
    "on-scroll-down": "",
  },
  "network": {
    "on-click":"omarchy-launch-wifi",
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀 {signalStrength}%",
    "tooltip-format": "{essid} - {ifname} via {gwaddr}",
    "format-linked": "󰖪",
    "format-disconnected": "󰖪",
  },
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-capture-screenrecording",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": " {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "omarchy-launch-bluetooth",
  },
}
