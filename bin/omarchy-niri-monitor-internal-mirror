#!/bin/bash

# omarchy:summary=Toggle mirroring the internal laptop display to an external monitor via wl-mirror
# omarchy:args=<on|off|toggle|recover>

STATE_FILE="$HOME/.local/state/omarchy/toggles/niri/mirror-on"
mkdir -p "$(dirname "$STATE_FILE")"

INTERNAL=$(niri msg outputs 2>/dev/null | grep -oP '\(\K[^)]+' | grep "eDP" | head -1)
EXTERNAL=$(niri msg outputs 2>/dev/null | grep -oP '\(\K[^)]+' | grep -v "eDP\|preferred\|current" | head -1)

enable() {
  if [[ -z $EXTERNAL ]]; then
    notify-send -u low "󰍹  No external monitor found"
    exit 1
  fi
  if [[ -z $INTERNAL ]]; then
    notify-send -u low "󰍹  No internal display found"
    exit 1
  fi
  if pgrep -x wl-mirror >/dev/null; then
    return 0
  fi

  local RULE_FILE="$HOME/.local/state/omarchy/toggles/niri/wl-mirror-output.kdl"
  local new_rule="window-rule {
    match app-id=\"at.yrlf.wl_mirror\"
    open-on-output \"$EXTERNAL\"
}"
  if [[ "$(cat "$RULE_FILE" 2>/dev/null)" != "$new_rule" ]]; then
    echo "$new_rule" > "$RULE_FILE"
    omarchy-restart-niri
  fi

  nohup wl-mirror --fullscreen-output "$EXTERNAL" "$INTERNAL" >/dev/null 2>&1 &
  disown $!
  touch "$STATE_FILE"
  notify-send -u low "󰍹  Mirroring enabled on $EXTERNAL"
}

disable() {
  local FOCUSED_ID
  FOCUSED_ID=$(niri msg --json focused-window 2>/dev/null | jq -r '.id // empty')

  local mirror_id
  mirror_id=$(niri msg --json windows 2>/dev/null | jq -r '.[] | select(.app_id == "at.yrlf.wl_mirror") | .id // empty' | head -1)

  if [[ -n $mirror_id ]]; then
    niri msg action close-window --id "$mirror_id" 2>/dev/null
  else
    pkill -x wl-mirror 2>/dev/null || true
  fi

  if [[ -n $FOCUSED_ID ]]; then
    niri msg action focus-window --id "$FOCUSED_ID" 2>/dev/null
  fi

  rm -f "$STATE_FILE"
  notify-send -u low "󰍹  Mirroring disabled"
}

recover() {
  if ! omarchy-hw-external-monitors && [[ -f $STATE_FILE ]]; then
    disable
  fi
}

case "$1" in
  on) enable ;;
  off) disable ;;
  toggle) [[ -f $STATE_FILE ]] && disable || enable ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
