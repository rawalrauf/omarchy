#!/bin/bash

# omarchy:summary=Lock before suspend, skip for hibernate (disk encryption handles that)
# omarchy:group=system
# omarchy:hidden=true

sleep_action=$(cat /sys/power/disk 2>/dev/null)

if [[ $sleep_action == *"[platform]"* || $sleep_action == *"[shutdown]"* ]]; then
  exit 0
fi

OMARCHY_LOCK_ONLY=true omarchy-system-lock
