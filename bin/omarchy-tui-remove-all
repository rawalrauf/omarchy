#!/bin/bash

# omarchy:summary=Remove all installed TUI shortcuts

set -e

DESKTOP_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons/hicolor/512x512@2/apps"

echo "Scanning for TUIs in $DESKTOP_DIR..."

tui_desktop_files=()
while IFS= read -r -d '' file; do
  tui_desktop_files+=("$file")
done < <(find "$DESKTOP_DIR" -maxdepth 1 -name "org.omarchy.*.desktop" -print0 2>/dev/null)

if ((${#tui_desktop_files[@]} == 0)); then
  echo "No TUIs found."
  exit 0
fi

for file in "${tui_desktop_files[@]}"; do
  full_id=$(basename "$file" .desktop)
  clean_name=$(echo "$full_id" | sed -E 's/^org\.omarchy\.(float\.|tile\.)?//')

  echo "Removing TUI: $clean_name"

  rm -f "$file"
  rm -f "$ICON_DIR/$full_id.png"
done

if command -v update-desktop-database &>/dev/null; then
  update-desktop-database "$DESKTOP_DIR" &>/dev/null
fi

gtk-update-icon-cache -q -f "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1

echo "All TUIs removed successfully."
