#!/bin/bash

# omarchy:summary=Remove preinstalled Omarchy applications (web apps, TUIs, and selected packages).

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?" </dev/tty; then
  echo -e "Removing preinstalled Omarchy applications...\n"

  omarchy-webapp-remove-all
  omarchy-tui-remove-all

  omarchy-refresh-niri

  # Remove npx stubs
  rm -f ~/.local/bin/opencode ~/.local/bin/ghui

  omarchy-pkg-drop \
    aether \
    typora \
    spotify \
    libreoffice-fresh \
    lazydocker \
    keepassxc \
    opencode
fi
