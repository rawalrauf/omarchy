#!/bin/bash

# omarchy:summary=Pick a color from the screen and copy hex to clipboard
# omarchy:group=capture
# omarchy:examples=omarchy capture color

hex=$(niri msg pick-color | grep "Hex:" | awk '{print $2}')
[[ -z $hex ]] && exit 0
printf '%s' "$hex" | wl-copy
notify-send -u low "󰃉  Color copied to clipboard" "$hex"
