#!/bin/bash

# omarchy:summary=Watch niri output events and recover monitor state when a monitor is removed

LAST_TRIGGER=0

niri msg --json event-stream 2>/dev/null | while read -r event; do
  if echo "$event" | grep -q '"WorkspacesChanged"'; then
    NOW=$(date +%s)
    if (( NOW - LAST_TRIGGER >= 3 )); then
      LAST_TRIGGER=$NOW
      omarchy-niri-monitor-internal recover
      omarchy-niri-monitor-internal-mirror recover
    fi
  fi
done
