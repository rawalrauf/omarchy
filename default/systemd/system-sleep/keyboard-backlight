#!/bin/bash

sleep_action=${SYSTEMD_SLEEP_ACTION:-$2}

device=""
for candidate in /sys/class/leds/*kbd_backlight*; do
  if [[ -e "$candidate" ]]; then
    device="$(basename "$candidate")"
    break
  fi
done

if [[ $1 == "pre" && $sleep_action == "suspend" ]]; then
  if [[ -n "$device" ]]; then
    brightnessctl -sd "$device" set 0 >/dev/null 2>&1
  fi
fi

if [[ $1 == "post" && $sleep_action == "suspend" ]]; then
  if [[ -n "$device" ]]; then
    uid=$(loginctl list-sessions --no-legend | awk '{print $2}' | head -1)
    [[ -n $uid ]] && su - "$(id -un "$uid")" -c \
      "XDG_RUNTIME_DIR=/run/user/${uid} brightnessctl -rd '$device'" >/dev/null 2>&1 || true
  fi
fi

if [[ $1 == "pre" && $sleep_action == "hibernate" ]]; then
  if [[ -n "$device" ]]; then
    brightnessctl -d "$device" set 0 >/dev/null 2>&1
  fi

  pkill -x hyprlock 2>/dev/null || true
fi

if [[ $1 == "post" && $sleep_action == "hibernate" ]]; then
  uid=$(loginctl list-sessions --no-legend | awk '{print $2}' | head -1)
  [[ -n $uid ]] && su - "$(id -un "$uid")" -c \
    "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus omarchy-restart-swayidle" >/dev/null 2>&1 || true
fi
