window-rule {
    match app-id=r"^org\.omarchy\.[^.]+$"
    match app-id="pqiv"
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 600; }
}
window-rule {
    match app-id="org.omarchy.about"
    open-floating true
    default-column-width { fixed 1050; }
    default-window-height { fixed 630; }
}
window-rule {
    match app-id="at.yrlf.wl_mirror"
    open-focused false
}
window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
}

