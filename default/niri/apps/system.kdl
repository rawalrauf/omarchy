window-rule {
    match app-id=r"^org\.omarchy\.[^.]+$"
    match app-id="pqiv"
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 600; }
}
window-rule {
    match app-id="at.yrlf.wl_mirror"
    open-focused false
}
window-rule {
    match app-id="mpv"
    open-floating true
    default-column-width { proportion 0.7150; }
    default-window-height { proportion 0.9050; }
}

