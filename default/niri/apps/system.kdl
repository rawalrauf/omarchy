// Omarchy TUI apps
window-rule {
    match app-id=r"^org\.omarchy\.[^.]+$"
    match app-id="pqiv"
    open-floating true
    default-column-width { fixed 875; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="org.omarchy.about"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 712; }
}

// wl-mirror
window-rule {
    match app-id="at.yrlf.wl_mirror"
    open-focused false
}

// Walker launcher
layer-rule {
    match namespace="^launcher$"
    opacity 0.80
    geometry-corner-radius 12
}
